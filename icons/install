#!/usr/bin/env bash

set -euo pipefail

usage() {
	echo "Usage: $0 [--debug] <link-list-path-or-URL>"
	echo
	echo "Options:"
	echo "  --debug    Download icons into an icons/ subdirectory instead of hicolor."
	echo "  -h, --help Show this help message."
}

DEBUG=0
LIST_SOURCE=""

for arg in "$@"; do
	case "$arg" in
	--debug)
		DEBUG=1
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		if [ -n "$LIST_SOURCE" ]; then
			echo "Error: Unexpected argument '$arg'." >&2
			usage >&2
			exit 1
		fi
		LIST_SOURCE="$arg"
		;;
	esac
done

if [ -z "$LIST_SOURCE" ]; then
	echo "Error: A link-list path or URL is required." >&2
	usage >&2
	exit 1
fi

if [ -z "${HOME:-}" ]; then
	echo "Error: HOME variable not set." >&2
	exit 1
fi

TMP_LIST=""

cleanup() {
	if [ -n "$TMP_LIST" ]; then
		rm -f -- "$TMP_LIST"
	fi
}

trap cleanup EXIT

# Download remote lists to a temporary file.
if [[ "$LIST_SOURCE" =~ ^https?:// ]]; then
	TMP_LIST="$(mktemp)"

	echo "Downloading link list..."

	if ! wget -qO "$TMP_LIST" "$LIST_SOURCE"; then
		echo "Error: Failed to download link list: $LIST_SOURCE" >&2
		exit 1
	fi

	LIST_FILE="$TMP_LIST"
	LIST_DIR="$PWD"
else
	if [ ! -r "$LIST_SOURCE" ]; then
		echo "Error: Link list is not readable: $LIST_SOURCE" >&2
		exit 1
	fi

	LIST_DIR="$(cd -- "$(dirname -- "$LIST_SOURCE")" && pwd)"
	LIST_FILE="$LIST_DIR/$(basename -- "$LIST_SOURCE")"
fi

# Choose the icon destination.
if [ "$DEBUG" -eq 1 ]; then
	ICONS_DIR="$LIST_DIR/icons"
	echo "Debug mode: downloading icons into $ICONS_DIR"
else
	ICONS_DIR="$HOME/.local/share/icons/hicolor/scalable/apps"
	echo "Installing icons into hicolor: $ICONS_DIR"
fi

mkdir -p -- "$ICONS_DIR"

if [ ! -w "$ICONS_DIR" ] || [ ! -x "$ICONS_DIR" ]; then
	echo "Error: No write and/or execute permission to $ICONS_DIR" >&2
	exit 1
fi

echo "Downloading Proton icons..."

pids=()
FAILED=0

while IFS= read -r line || [ -n "$line" ]; do
	# Ignore blank lines and comments.
	[[ "$line" =~ ^[[:space:]]*$ ]] && continue
	[[ "$line" =~ ^[[:space:]]*# ]] && continue

	if [[ "$line" != *=* ]]; then
		echo "Error: Invalid list entry: $line" >&2
		FAILED=1
		continue
	fi

	filename="${line%%=*}"
	url="${line#*=}"

	if [[ ! "$filename" =~ ^[a-zA-Z0-9._-]+\.svg$ ]] || [ -z "$url" ]; then
		echo "Error: Invalid filename or URL in entry: $line" >&2
		FAILED=1
		continue
	fi

	(
		tmp_file="$(mktemp "$ICONS_DIR/.${filename}.XXXXXX")"
		trap 'rm -f -- "$tmp_file"' EXIT

		if wget -qO "$tmp_file" "$url" 2>/dev/null; then
			mv -f -- "$tmp_file" "$ICONS_DIR/$filename"
			trap - EXIT
			echo "Downloaded: $filename"
		else
			echo "Error: Failed to download $filename" >&2
			exit 1
		fi
	) &

	pids+=("$!")
done <"$LIST_FILE"

for pid in "${pids[@]}"; do
	if ! wait "$pid"; then
		FAILED=1
	fi
done

if [ "$FAILED" -ne 0 ]; then
	echo "Error: One or more icons failed to download." >&2
	exit 1
fi

echo "All Proton icons downloaded successfully."
